@using SummerSchool.ApplicationSystems.Mvc.Common.Constants
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Yönetici Paneli</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/plugins/toastr/toastr.min.css">

    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        .admin-header {
            background: #2f4050;
            padding: 1rem 0;
            position: fixed;
            top: 0;
            right: 0;
            width: 100%;
            z-index: 1000;
            color: white;
        }

        .admin-header h3 {
            color: white;
            margin: 0;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div id="wrapper">
        <div id="page-wrapper">
            <div class="admin-header">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-md-3 col-2">
                            <a href="@RouteConstants.ADMIN_INDEX">
                                <img src="https://halic.edu.tr/wp-content/uploads/2025/06/25/halic_universitesi_logo.svg"
                                     width="80"
                                     height="80"
                                     class="logo-white"
                                     alt="Haliç Üniversitesi">
                            </a>
                        </div>
                        <div class="col-md-6 col-8 text-center">
                            <h3>Yönetici Paneli - Yaz Okulu Ders Başvuru Sistemi</h3>
                        </div>
                        <div class="col-md-3 col-2 text-right">
                            <a href="@RouteConstants.ADMIN_LOGOUT" class="btn btn-danger">
                                <i class="fa fa-sign-out"></i> Çıkış
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="wrapper wrapper-content" style="padding-top:140px;">
                <div class="row">
                    <div class="col-12">
                        @RenderBody()
                    </div>
                </div>
            </div>
            <div class="footer position-fixed">
                <strong>Copyright</strong> Haliç Üniversitesi - Yönetici Paneli &copy; 2026
            </div>
        </div>
    </div>

    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script src="~/js/plugins/metisMenu/jquery.metisMenu.js"></script>
    <script src="~/js/plugins/slimscroll/jquery.slimscroll.min.js"></script>
    <script src="~/js/inspinia.js"></script>
    <script src="~/js/plugins/pace/pace.min.js"></script>
    <script src="~/js/plugins/toastr/toastr.min.js"></script>
    <script src="~/js/pages/base.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
