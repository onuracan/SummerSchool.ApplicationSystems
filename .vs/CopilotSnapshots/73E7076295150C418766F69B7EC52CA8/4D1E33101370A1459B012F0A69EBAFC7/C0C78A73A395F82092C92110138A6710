/* Wrapper ve Page Wrapper genişlik ayarları */
#wrapper {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
}

#page-wrapper {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    position: relative !important;
}

.wrapper-content {
    width: 100% !important;
    max-width: none !important;
    margin: 0 auto !important;
    padding-left: 30px !important;
    padding-right: 30px !important;
}

.container-fluid {
    width: 100% !important;
    max-width: 100% !important;
    padding-left: 15px !important;
    padding-right: 15px !important;
}

/* Row düzenlemeleri */
.row {
    margin-left: 0 !important;
    margin-right: 0 !important;
}

/* Tab ve ibox container düzenlemeleri */
.ibox {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
}

.ibox-content {
    width: 100% !important;
    box-sizing: border-box;
    padding: 20px !important;
}

.tabs-container {
    width: 100% !important;
    box-sizing: border-box;
}

.tab-content {
    width: 100% !important;
    box-sizing: border-box;
    padding: 20px 0 !important;
}

.tab-pane {
    width: 100% !important;
    box-sizing: border-box;
}

.panel-body {
    width: 100% !important;
    box-sizing: border-box;
    padding: 0 !important;
}

/* Responsive tablolar için */
.table-responsive {
    width: 100% !important;
    overflow-x: auto;
    overflow-y: visible !important;
    margin-bottom: 0 !important;
}

/* DataTable pagination düzenlemeleri */
.dataTables_wrapper {
    width: 100% !important;
    overflow: visible !important;
    position: relative !important;
}

.dataTables_wrapper .dataTables_paginate {
    white-space: normal !important;
    text-align: right !important;
    overflow: visible !important;
    margin-top: 15px !important;
    width: 100% !important;
    display: block !important;
    position: relative !important;
    z-index: 10 !important;
}

.dataTables_wrapper .dataTables_paginate .pagination {
    flex-wrap: wrap !important;
    justify-content: flex-end !important;
    margin: 0 !important;
    display: flex !important;
    overflow: visible !important;
}

.dataTables_wrapper .dataTables_info {
    white-space: normal !important;
    padding-top: 15px !important;
    padding-bottom: 15px !important;
}

.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter {
    margin-bottom: 15px !important;
}

.dataTables_wrapper .row {
    width: 100% !important;
    margin: 0 !important;
    overflow: visible !important;
    position: relative !important;
}

.dataTables_wrapper .col-sm-12,
.dataTables_wrapper .col-md-7,
.dataTables_wrapper .col-md-5,
.dataTables_wrapper [class*="col-"] {
    overflow: visible !important;
    min-height: 70px !important;
    position: relative !important;
}

/* Pagination butonları için */
.pagination {
    margin: 0 !important;
    flex-wrap: wrap !important;
    overflow: visible !important;
}

.pagination .page-item {
    margin: 2px !important;
}

.pagination .page-link {
    padding: 0.5rem 0.75rem !important;
    white-space: nowrap !important;
    display: inline-block !important;
}

/* DataTable ile ilgili genel düzenlemeler */
.dataTables-example {
    width: 100% !important;
    margin-bottom: 20px !important;
}

/* Table responsive içindeki DataTable düzeltmeleri */
.table-responsive {
    position: relative !important;
    overflow-x: auto !important;
    overflow-y: visible !important;
    padding-bottom: 80px !important;
}

.table-responsive .dataTables_wrapper {
    overflow: visible !important;
    position: static !important;
}

.table-responsive .dataTables_wrapper .dataTables_paginate {
    position: absolute !important;
    bottom: 0 !important;
    right: 0 !important;
    width: auto !important;
    background: white !important;
    padding: 10px !important;
}

.table-responsive + .dataTables_wrapper .dataTables_paginate,
.table-responsive ~ .dataTables_paginate {
    overflow: visible !important;
    width: 100% !important;
}

/* Responsive ekran boyutları için */
@media (max-width: 1400px) {
    .wrapper-content {
        padding-left: 20px !important;
        padding-right: 20px !important;
    }
}

@media (max-width: 992px) {
    .wrapper-content {
        padding-left: 15px !important;
        padding-right: 15px !important;
    }
}

@media (max-width: 768px) {
    .wrapper-content {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .ibox-content {
        padding: 15px !important;
    }
}
