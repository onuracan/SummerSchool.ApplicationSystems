/* Tab ve ibox container düzenlemeleri */
.ibox {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
}

.ibox-content {
    width: 100% !important;
    box-sizing: border-box;
}

.tabs-container {
    width: 100% !important;
    box-sizing: border-box;
}

.tab-content {
    width: 100% !important;
    box-sizing: border-box;
}

.tab-pane {
    width: 100% !important;
    box-sizing: border-box;
}

.panel-body {
    width: 100% !important;
    box-sizing: border-box;
}

/* Responsive tablolar için */
.table-responsive {
    width: 100% !important;
    overflow-x: auto;
}
