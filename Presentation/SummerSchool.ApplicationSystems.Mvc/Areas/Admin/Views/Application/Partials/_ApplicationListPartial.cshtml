@using SummerSchool.ApplicationSystems.Mvc.Models.Course.Response

@model IEnumerable<CourseDropdownListResponseViewModel>

<style>
    #rejectModal {
        z-index: 1050 !important;
    }

        #rejectModal .modal-backdrop {
            z-index: 1040 !important;
        }
</style>

<div class="row">
    <div class="col-3">
        <div class="form-group">
            <label for="drpCourse">Ders</label>
            <select class="form-control" id="drpCourse" name="drpCourse" required="">
                <option value="">Ders Seçiniz</option>
                @foreach (var item in Model)
                {
                    <option value="@item.Id">@item.CourseInfo</option>
                }
            </select>
        </div>
    </div>
    <div class="col-3 d-flex align-items-center mt-2">
        <button type="button" id="btnSearch" class="btn btn-lg btn-success">Ara</button>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table id="dtApplications" class="table table-striped table-bordered table-hover dataTables-example">
                <thead>
                    <tr>
                        <th>-</th>
                        <th>Öğrenci</th>
                        <th>Ders</th>
                        <th>Başvuru Durumu</th>
                        <th>Güncelleyen</th>
                        <th>Güncellenme Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
