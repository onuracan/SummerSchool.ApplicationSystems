@using SummerSchool.ApplicationSystems.Mvc.Models.Base.Response
@using SummerSchool.ApplicationSystems.Mvc.Models.Course.Response

@{
    var response = (ApiResponse<IEnumerable<CourseDropdownListResponseViewModel>>)ViewBag.Response;
}

@section Styles {
    <link href="~/css/plugins/dataTables/datatables.min.css" rel="stylesheet">
}

@section Scripts {
    <script src="~/js/plugins/dataTables/datatables.min.js"></script>
    <script src="~/js/plugins/dataTables/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/pages/admin/application.js"></script>
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5>Kontenjan Listesi</h5>
            </div>
            <div class="ibox-content">
                @{
                    await Html.RenderPartialAsync("Partials/_CourseQuotaListPartial");
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5>Başvurular</h5>
            </div>
            <div class="ibox-content">
                @{
                    await Html.RenderPartialAsync("Partials/_ApplicationListPartial", response.Result);
                }
            </div>
        </div>
    </div>
</div>
